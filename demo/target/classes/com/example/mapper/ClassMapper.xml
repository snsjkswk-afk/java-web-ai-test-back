<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.example.mapper.ClassMapper">
    <insert id="add">
        insert into clazz(name,room,begin_date,end_date,master_id,subject)
        values(#{name},#{room},#{begin},#{end},#{masterId},#{subject})
    </insert>
    <update id="update">
        update clazz
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="room != null">
                room = #{room},
            </if>
            <if test="beginDate != null">
                begin_date = #{beginDate},
            </if>
            <if test="endDate != null">
                end_date = #{endDate},
            </if>
            <if test="masterId != null">
                master_id = #{masterId},
            </if>
            <if test="subject != null">
                subject = #{subject},
            </if>
        </set>
    </update>
    <delete id="delete">
        delete from clazz where id = #{id}
    </delete>

    <!-- 直接引用外部 SQL 片段 -->


    <select id="ps" resultType="com.example.pojo.Clazz">
        select * from clazz
        <where>
            <if test="name != null">
                and name like concat('%',#{name},'%')
            </if>
            <if test="begin != null">
                and begin >= #{beginDate}
            </if>
            <if test="end != null">   <!-- 这里修复了 -->
                and end &lt;= #{endDate}
            </if>
        </where>
    </select>
    <select id="findAll">
        select * from clazz
    </select>
    <select id="getById" resultType="com.example.pojo.Clazz">
        select * from clazz where id = #{id}
    </select>
</mapper>